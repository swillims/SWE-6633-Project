<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ProjectManagementGui.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:DataType="vm:GeneralInfoViewModel"
             x:Class="ProjectManagementGui.Views.GeneralInfoControl">
    
    <StackPanel>
        <!-- Project Details-->
        <Border
            Background="#F9FAFBFF"
            CornerRadius="8"
            Padding="16"
            BorderThickness="1"
            BorderBrush="#E0E0E0"
            Margin="10">

            <Grid RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*">

                <!-- HEADER ROW -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                    <!-- Emoji + Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="ℹ️"
                                   FontSize="18"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Project Details"
                                   FontWeight="Bold"
                                   FontSize="16"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Spacer -->
                    <Border Grid.Column="1"/>

                    <!-- Edit link -->
                    <TextBlock Grid.Column="2"
                               Text="Edit"
                               Foreground="#6C63FF"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Cursor="Hand"/>
                </Grid>

                <!-- CONTENT -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="12">
                    
                    <!-- Project Owner -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Project Owner"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="Alice Johnson"
                                   FontSize="13"/>
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="Description"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="A next-generation online shopping platform with AI-powered recommendations and a seamless checkout experience."
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                </StackPanel>

            </Grid>
        </Border>
        
        <!-- Team Members-->
        <Border
            Background="#F9FAFB"
            CornerRadius="8"
            Padding="16"
            BorderThickness="1"
            BorderBrush="#E0E0E0"
            Margin="10">

            <StackPanel Spacing="16">

                <!-- HEADER -->
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="👥"
                               FontSize="18"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Team Members"
                               FontWeight="Bold"
                               FontSize="16"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- SCROLLABLE LIST -->
                <ScrollViewer MaxHeight="100"> <!-- adjust height if you want -->
                    <ItemsControl>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto"
                                      Background="#FFFFFF"
                                      Margin="0,0,0,8">
                                    <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="🗑️"
                                               Cursor="Hand"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Add new member row -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Watermark="Add new member"/>
                    <Button Grid.Column="1"
                            Background="#94D3A2"
                            Foreground="White"
                            Padding="10,4"
                            CornerRadius="4"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="➕"/>
                            <TextBlock Text="Add"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

        <!-- Risks -->
        <Border
            Background="#F9FAFB"
            CornerRadius="8"
            Padding="16"
            BorderThickness="1"
            BorderBrush="#E0E0E0"
            Margin="10">

            <StackPanel Spacing="16">

                <!-- HEADER -->
                <TextBlock Text="Risks"
                           FontWeight="Bold"
                           FontSize="16"/>

                <!-- SCROLLABLE RISK LIST -->
                <ScrollViewer MaxHeight="150"> <!-- adjust height -->
                    <ItemsControl ItemsSource="{Binding Risks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto,Auto"
                                      Background="#FFFFFF"
                                      Margin="0,0,0,8">

                                    <!-- Risk Description -->
                                    <TextBlock Text="{Binding Description}"
                                               VerticalAlignment="Center"/>

                                    <!-- Status Dropdown -->
                                    <ComboBox Grid.Column="1"
                                              Width="120"
                                              SelectedIndex="0">
                                        <ComboBoxItem Content="Open"/>
                                        <ComboBoxItem Content="InProgress"/>
                                        <ComboBoxItem Content="Closed"/>
                                    </ComboBox>

                                    <!-- Delete -->
                                    <TextBlock Grid.Column="2"
                                               Text="🗑️"
                                               Margin="8,0,0,0"
                                               Cursor="Hand"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>
                </ScrollViewer>

                <!-- Add New Risk -->
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Watermark="Describe a new risk"/>

                    <Button Grid.Column="1"
                            Background="#94D3A2"
                            Foreground="White"
                            Padding="10,4"
                            CornerRadius="4"
                            Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="➕"/>
                            <TextBlock Text="Add"/>
                        </StackPanel>
                    </Button>
                </Grid>

            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
