<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ProjectManagementGui.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:DashboardViewModel"
             x:Class="ProjectManagementGui.Views.DashboardControl">
    
    <StackPanel Spacing="24">
        
        <!-- Total Hours Card -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Project Effort Summary"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Total hours expended across all tasks."
                           FontSize="12"
                           Foreground="#6B7280"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TotalHours}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#6366F1"/>
                    <TextBlock Text="Total Hours"
                               FontSize="16"
                               Foreground="#6B7280"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,6"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
