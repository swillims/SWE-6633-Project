<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="using:ProjectManagementGui.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="vm:DashboardViewModel"
             x:Class="ProjectManagementGui.Views.DashboardControl">
    
    <StackPanel Spacing="24">
        
        <!-- Total Hours Card -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel Spacing="8">
                <TextBlock Text="Project Effort Summary"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                <TextBlock Text="Total hours expended across all tasks."
                           FontSize="12"
                           Foreground="#6B7280"/>
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
                    <TextBlock Text="{Binding TotalHours}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="#6366F1"/>
                    <TextBlock Text="Total Hours"
                               FontSize="16"
                               Foreground="#6B7280"
                               VerticalAlignment="Bottom"
                               Margin="0,0,0,6"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
        <!-- Hours by Category Chart -->
        <Border Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24">
            <StackPanel Spacing="16">
                <TextBlock Text="Hours by Category"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#111827"/>
                
                <!-- Chart Area -->
                <Grid Height="300">
                    <!-- Background Grid Lines -->
                    <Canvas>
                        <Line StartPoint="0,0" EndPoint="1200,0" 
                              Stroke="#E5E7EB" StrokeThickness="1"
                              Canvas.Top="240"/>
                        <Line StartPoint="0,0" EndPoint="1200,0" 
                              Stroke="#E5E7EB" StrokeThickness="1"
                              Canvas.Top="180"/>
                        <Line StartPoint="0,0" EndPoint="1200,0" 
                              Stroke="#E5E7EB" StrokeThickness="1"
                              Canvas.Top="120"/>
                        <Line StartPoint="0,0" EndPoint="1200,0" 
                              Stroke="#E5E7EB" StrokeThickness="1"
                              Canvas.Top="60"/>
                        <Line StartPoint="0,0" EndPoint="1200,0" 
                              Stroke="#E5E7EB" StrokeThickness="1"
                              Canvas.Top="0"/>
                        
                        <!-- Y-axis Labels -->
                        <TextBlock Text="80" Canvas.Left="0" Canvas.Top="-8"
                                   FontSize="11" Foreground="#9CA3AF"/>
                        <TextBlock Text="60" Canvas.Left="0" Canvas.Top="52"
                                   FontSize="11" Foreground="#9CA3AF"/>
                        <TextBlock Text="40" Canvas.Left="0" Canvas.Top="112"
                                   FontSize="11" Foreground="#9CA3AF"/>
                        <TextBlock Text="20" Canvas.Left="0" Canvas.Top="172"
                                   FontSize="11" Foreground="#9CA3AF"/>
                        <TextBlock Text="0" Canvas.Left="0" Canvas.Top="232"
                                   FontSize="11" Foreground="#9CA3AF"/>
                    </Canvas>
                    
                    <!-- Bars -->
                    <ItemsControl ItemsSource="{Binding CategoryHours}" Margin="40,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Height="300"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Canvas.Left="{Binding XPosition}"
                                      Canvas.Top="{Binding YPosition}"
                                      Width="80"
                                      RowDefinitions="Auto,Auto">
                                    <Rectangle Grid.Row="0"
                                               Fill="#6366F1"
                                               Width="80"
                                               Height="{Binding BarHeight}"
                                               RadiusX="4"
                                               RadiusY="4"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Category}"
                                               FontSize="11"
                                               Foreground="#6B7280"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               HorizontalAlignment="Center"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                
                <!-- Legend -->
                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Center"
                           Spacing="8">
                    <Rectangle Fill="#6366F1" Width="12" Height="12"/>
                    <TextBlock Text="hours" 
                              FontSize="12" 
                              Foreground="#6B7280"/>
                </StackPanel>
            </StackPanel>
        </Border>
        
    </StackPanel>
</UserControl>
